#include <stdio.h>
#include <string.h>
#include <conio.h>  /* Note: _getch() is standard on Windows compilers */

#define MAX_LEN 32

void get_masked_input(char *buffer, int max_len) {
    int i = 0;
    char ch;

    while (1) {
        ch = _getch(); // Read character without echoing to screen

        // Check for Enter key (ASCII 13 or '\n')
        if (ch == 13 || ch == '\n') {
            buffer[i] = '\0';
            printf("\n");
            break;
        } 
        // Handle Backspace (ASCII 8)
        else if (ch == 8) {
            if (i > 0) {
                i--;
                printf("\b \b"); // Move cursor back, erase char, move back again
            }
        } 
        // Printable ASCII range
        else if (i < max_len - 1 && ch >= 32 && ch <= 126) {
            buffer[i++] = ch;
            printf("*"); // Mask input with asterisk
        }
    }
}

int main() {
    const char CORRECT_USERNAME[] = "admin";
    const char CORRECT_PASSWORD[] = "SecurePass123";

    char username[MAX_LEN];
    char password[MAX_LEN];

    printf("=== SYSTEM LOGIN ===\n");

    printf("Enter Username: ");
    if (fgets(username, sizeof(username), stdin) != NULL) {
        // Strip trailing newline character if present
        username[strcspn(username, "\n")] = '\0';
    }

    printf("Enter Password: ");
    get_masked_input(password, MAX_LEN);

    // Verify credentials
    if (strcmp(username, CORRECT_USERNAME) == 0 && strcmp(password, CORRECT_PASSWORD) == 0) {
        printf("\n[SUCCESS] Access Granted. Welcome!\n");
    } else {
        printf("\n[ERROR] Invalid Username or Password. Access Denied.\n");
    }

    return 0;
}
