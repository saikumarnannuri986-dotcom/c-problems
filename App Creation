import tkinter as tk
from tkinter import messagebox

students = []

def add_student():
    name = name_entry.get()
    roll = roll_entry.get()
    dept = dept_entry.get()

    if name == "" or roll == "" or dept == "":
        messagebox.showwarning("Warning", "Please fill all fields!")
        return

    students.append([name, roll, dept])
    messagebox.showinfo("Success", "Student Added Successfully!")

    name_entry.delete(0, tk.END)
    roll_entry.delete(0, tk.END)
    dept_entry.delete(0, tk.END)

def show_students():
    output.delete("1.0", tk.END)
    if not students:
        output.insert(tk.END, "No student records found.\n")
    else:
        for i, student in enumerate(students, start=1):
            output.insert(
                tk.END,
                f"{i}. Name: {student[0]}, Roll: {student[1]}, Department: {student[2]}\n"
            )

root = tk.Tk()
root.title("Student Management App")
root.geometry("450x450")

tk.Label(root, text="Student Name").pack()
name_entry = tk.Entry(root, width=30)
name_entry.pack()

tk.Label(root, text="Roll Number").pack()
roll_entry = tk.Entry(root, width=30)
roll_entry.pack()

tk.Label(root, text="Department").pack()
dept_entry = tk.Entry(root, width=30)
dept_entry.pack()

tk.Button(root, text="Add Student", command=add_student).pack(pady=5)
tk.Button(root, text="Show Students", command=show_students).pack(pady=5)

output = tk.Text(root, height=12, width=50)
output.pack(pady=10)

root.mainloop()
