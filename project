#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Project {
    int id;
    char name[50];
    char status[20];
};

void addProject(struct Project projects[], int *count) {
    printf("Enter Project ID: ");
    scanf("%d", &projects[*count].id);
    getchar();
    
    printf("Enter Project Name: ");
    fgets(projects[*count].name, 50, stdin);
    projects[*count].name[strcspn(projects[*count].name, "\n")] = 0;
    
    printf("Enter Status (e.g., Pending, In Progress, Completed): ");
    fgets(projects[*count].status, 20, stdin);
    projects[*count].status[strcspn(projects[*count].status, "\n")] = 0;
    
    (*count)++;
    printf("Project added successfully.\n\n");
}

void displayProjects(struct Project projects[], int count) {
    if (count == 0) {
        printf("No projects found.\n\n");
        return;
    }
    
    printf("\n%-10s %-30s %-20s\n", "ID", "Name", "Status");
    printf("------------------------------------------------------------\n");
    for (int i = 0; i < count; i++) {
        printf("%-10d %-30s %-20s\n", projects[i].id, projects[i].name, projects[i].status);
    }
    printf("\n");
}

int main() {
    struct Project projects[100];
    int count = 0;
    int choice;

    while (1) {
        printf("=== Project Management System ===\n");
        printf("1. Add Project\n");
        printf("2. View All Projects\n");
        printf("3. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                addProject(projects, &count);
                break;
            case 2:
                displayProjects(projects, count);
                break;
            case 3:
                exit(0);
            default:
                printf("Invalid choice. Try again.\n\n");
        }
    }

    return 0;
}
