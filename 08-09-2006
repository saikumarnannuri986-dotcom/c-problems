# Bucket Company Management System

products = {
    "Plastic Bucket": {"price": 150, "stock": 20},
    "Steel Bucket": {"price": 450, "stock": 15},
    "Dustbin Bucket": {"price": 250, "stock": 10},
    "Water Bucket": {"price": 200, "stock": 25}
}

def display_products():
    print("\n--- Available Buckets ---")
    for name, details in products.items():
        print(f"{name} - Rs.{details['price']} - Stock: {details['stock']}")

def sell_bucket():
    display_products()

    name = input("\nEnter bucket name: ")

    if name in products:
        quantity = int(input("Enter quantity: "))

        if quantity <= products[name]["stock"]:
            total = quantity * products[name]["price"]
            products[name]["stock"] -= quantity

            print("\nSale Successful!")
            print("Product:", name)
            print("Quantity:", quantity)
            print("Total Amount: Rs.", total)
        else:
            print("Sorry! Not enough stock.")
    else:
        print("Product not found.")

while True:
    print("\n===== BUCKET COMPANY =====")
    print("1. Display Products")
    print("2. Sell Bucket")
    print("3. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        display_products()
    elif choice == "2":
        sell_bucket()
    elif choice == "3":
        print("Thank you for using Bucket Company System!")
        break
    else:
        print("Invalid choice!")
