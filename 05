#include <stdio.h>

int main() {
    char *books[] = {"Java", "Python", "C Programming", "Data Structures", "Cyber Security"};
    int n;

    printf("Library Books:\n");
    for(int i = 0; i < 5; i++)
        printf("%d. %s\n", i + 1, books[i]);

    printf("Enter book number to borrow: ");
    scanf("%d", &n);

    if(n >= 1 && n <= 5)
        printf("You borrowed: %s\n", books[n - 1]);
    else
        printf("Invalid book number\n");

    return 0;
}
