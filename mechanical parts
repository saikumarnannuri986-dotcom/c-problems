# Mechanical Parts Management System

class MechanicalPart:
    def __init__(self, part_id, name, material, quantity, price):
        self.part_id = part_id
        self.name = name
        self.material = material
        self.quantity = quantity
        self.price = price

    def display(self):
        print(f"\nPart ID   : {self.part_id}")
        print(f"Name      : {self.name}")
        print(f"Material  : {self.material}")
        print(f"Quantity  : {self.quantity}")
        print(f"Price     : ₹{self.price:.2f}")


parts = []

while True:
    print("\n===== Mechanical Parts Management =====")
    print("1. Add Part")
    print("2. Display All Parts")
    print("3. Search Part")
    print("4. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        part_id = input("Enter Part ID: ")
        name = input("Enter Part Name: ")
        material = input("Enter Material: ")
        quantity = int(input("Enter Quantity: "))
        price = float(input("Enter Price: "))

        part = MechanicalPart(part_id, name, material, quantity, price)
        parts.append(part)

        print("Part added successfully!")

    elif choice == "2":
        if not parts:
            print("No parts available.")
        else:
            print("\n--- Mechanical Parts List ---")
            for part in parts:
                part.display()

    elif choice == "3":
        search_id = input("Enter Part ID to search: ")
        found = False

        for part in parts:
            if part.part_id == search_id:
                print("\nPart Found:")
                part.display()
                found = True
                break

        if not found:
            print("Part not found.")

    elif choice == "4":
        print("Thank you for using Mechanical Parts Management System.")
        break

    else:
        print("Invalid choice! Please try again.")
