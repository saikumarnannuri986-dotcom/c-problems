# Company Management System

companies = []

def add_company():
    name = input("Enter company name: ")
    location = input("Enter company location: ")
    employees = int(input("Enter number of employees: "))
    industry = input("Enter industry: ")

    company = {
        "name": name,
        "location": location,
        "employees": employees,
        "industry": industry
    }

    companies.append(company)
    print("Company added successfully!\n")


def display_companies():
    if not companies:
        print("No companies available.")
        return

    print("\n--- Company Details ---")
    for company in companies:
        print("Company Name :", company["name"])
        print("Location     :", company["location"])
        print("Employees    :", company["employees"])
        print("Industry     :", company["industry"])
        print("------------------------")


while True:
    print("\n1. Add Company")
    print("2. Display Companies")
    print("3. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        add_company()
    elif choice == "2":
        display_companies()
    elif choice == "3":
        print("Thank you!")
        break
    else:
        print("Invalid choice!")
